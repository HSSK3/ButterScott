@model ButterScott.Models.Cupom

@{
    ViewData["Title"] = "Novo Cupom";
}

<div class="container mt-4">
    <h2>Novo Cupom</h2>
    <p class="text-muted">Preencha os dados para cadastrar um novo cupom.</p>

    <form asp-action="Criar" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="codigo" class="form-label">Código do cupom</label>
            <input asp-for="codigo" class="form-control" maxlength="40"
                   placeholder="Ex.: DOCE10" />
            <span asp-validation-for="codigo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="descricao" class="form-label">Descrição</label>
            <input asp-for="descricao" class="form-control" maxlength="255"
                   placeholder="Ex.: 10% de desconto no pedido" />
            <span asp-validation-for="descricao" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="tipo_desconto" class="form-label">Tipo de desconto</label>
                <select asp-for="tipo_desconto" class="form-select">
                    <option value="Percentual">Percentual (%)</option>
                    <option value="ValorFixo">Valor fixo (R$)</option>
                </select>
                <span asp-validation-for="tipo_desconto" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="valor_desconto" class="form-label">Valor do desconto</label>
                <input asp-for="valor_desconto" type="number" class="form-control"
                       min="0.01" step="0.01" />
                <span asp-validation-for="valor_desconto" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="valor_minimo_pedido" class="form-label">Valor mínimo do pedido (R$)</label>
            <input asp-for="valor_minimo_pedido" type="number" class="form-control"
                   min="0" step="0.01" />
            <span asp-validation-for="valor_minimo_pedido" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="data_inicio" class="form-label">Data de início</label>
                <input asp-for="data_inicio" type="datetime-local" class="form-control" />
                <span asp-validation-for="data_inicio" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="data_fim" class="form-label">Data de término</label>
                <input asp-for="data_fim" type="datetime-local" class="form-control" />
                <span asp-validation-for="data_fim" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="limite_uso" class="form-label">Limite de utilizações</label>
            <input asp-for="limite_uso" type="number" class="form-control"
                   min="1" placeholder="Deixe vazio para ilimitado" />
            <span asp-validation-for="limite_uso" class="text-danger"></span>
            <small class="text-muted">Deixe em branco caso não queira limitar o uso.</small>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Cadastrar cupom</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>