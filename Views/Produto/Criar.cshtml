
@model ButterScott.Models.Produto

@{
    ViewData["Title"] = "Novo produto";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted">
            ← Voltar para produtos
        </a>

        <h2 class="fw-bold mt-3">Cadastrar produto</h2>
        <p class="text-muted">
            Preencha as informações do novo produto.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Criar" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="nome" class="form-label">
                            Nome do produto
                        </label>
                        <input asp-for="nome"
                               class="form-control"
                               maxlength="120"
                               required />
                        <span asp-validation-for="nome"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="id_categoria" class="form-label">
                            Categoria
                        </label>
                        <select asp-for="id_categoria"
                                class="form-select"
                                required>
                            <option value="">Selecione uma categoria</option>
                            @foreach (var categoria in ViewBag.Categorias)
                            {
                                <option value="@categoria.id_categoria">
                                    @categoria.nome
                                </option>
                            }
                        </select>
                        <span asp-validation-for="id_categoria"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="descricao" class="form-label">
                            Descrição
                        </label>
                        <textarea asp-for="descricao"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Descreva o produto..."></textarea>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="sabor" class="form-label">
                            Sabor
                        </label>
                        <input asp-for="sabor"
                               class="form-control"
                               maxlength="80"
                               required />
                        <span asp-validation-for="sabor"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="preco" class="form-label">
                            Preço (R$)
                        </label>
                        <input asp-for="preco"
                               type="number"
                               class="form-control"
                               min="0.01"
                               step="0.01"
                               required />
                        <span asp-validation-for="preco"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="estoque" class="form-label">
                            Quantidade em estoque
                        </label>
                        <input asp-for="estoque"
                               type="number"
                               class="form-control"
                               min="0"
                               step="1"
                               required />
                        <span asp-validation-for="estoque"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="imagem_url" class="form-label">
                            URL da imagem
                        </label>
                        <input asp-for="imagem_url"
                               class="form-control"
                               maxlength="500"
                               placeholder="https://exemplo.com/imagem.jpg" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    <button type="submit" class="btn btn-success">
                        Cadastrar produto
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
