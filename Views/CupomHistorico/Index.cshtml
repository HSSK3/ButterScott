
@model List<ButterScott.Models.CupomHistoricoViewModel>

@{
    ViewData["Title"] = "Histórico de Cupons";
    var cultura = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Histórico de Utilização de Cupons</h2>
            <p class="text-muted">Consulte os cupons utilizados pelos clientes.</p>
        </div>

        <a asp-controller="Cupom" asp-action="Index" class="btn btn-secondary">
            Voltar aos cupons
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Nenhuma utilização de cupom foi registrada até o momento.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Cupom</th>
                        <th>Cliente</th>
                        <th>Pedido</th>
                        <th>Data de utilização</th>
                        <th>Desconto aplicado</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.codigo_cupom</strong>
                                @if (!string.IsNullOrWhiteSpace(item.descricao_cupom))
                                {
                                    <br />
                                    <small class="text-muted">@item.descricao_cupom</small>
                                }
                            </td>

                            <td>
                                @item.nome_cliente
                                <br />
                                <small class="text-muted">@item.email_cliente</small>
                            </td>

                            <td>
                                <a asp-controller="Pedido"
                                   asp-action="Detalhes"
                                   asp-route-id="@item.id_pedido">
                                    #@item.id_pedido
                                </a>
                            </td>

                            <td>
                                @item.data_utilizacao.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                <strong class="text-success">
                                    @item.valor_desconto_aplicado.ToString("C2", cultura)
                                </strong>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            <strong>Total de utilizações:</strong> @Model.Count
        </div>
    }
</div>
