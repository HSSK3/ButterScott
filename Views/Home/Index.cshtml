
@model IEnumerable<ButterScott.Models.ProdutoHomeViewModel>

@{
    ViewData["Title"] = "Nossos Doces";
    bool clienteLogado = Context.Session.GetString("ClienteId") != null;
}

@if (TempData["MensagemCarrinho"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["MensagemCarrinho"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Fechar"></button>
    </div>
}

@if (TempData["MensagemFavorito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["MensagemFavorito"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Fechar"></button>
    </div>
}

@if (TempData["ErroFavorito"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErroFavorito"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Fechar"></button>
    </div>
}

<section class="py-5 px-3 mb-5 text-center"
         style="background: linear-gradient(135deg, #fafad4, #f9c593); border-radius: 24px;">

    <div class="container py-4">

        <img src="~/images/Logo.png"
             alt="Logo ButterScott - Cupcakes e doces"
             class="img-fluid mb-4"
             style="width: 100%; max-width: 320px; height: auto;" />

        <p class="text-uppercase fw-bold mb-2"
           style="letter-spacing: 3px; color: #9b5c4e;">
            Feito com carinho
        </p>

        <h1 class="display-3 fw-bold mb-3">
            Um doce momento para você
        </h1>

        <p class="lead mx-auto mb-4" style="max-width: 650px;">
            Cupcakes deliciosos para adoçar seu dia.
            Descubra nossos sabores e escolha seu próximo favorito!
        </p>

        <a href="#produtos" class="btn btn-primary btn-lg">
            Conheça nossos cupcakes
        </a>

    </div>
</section>

<div class="container pb-5" id="produtos">

    <div class="text-center mb-5">

        <p class="text-uppercase fw-bold mb-2"
           style="letter-spacing: 2px; color: #89b2a2;">
            Nossa seleção
        </p>

        <h2 class="display-5 fw-bold">Nossos cupcakes</h2>

        <p class="text-muted">
            Encontre um sabor especial para cada momento.
        </p>

    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            Ainda não temos produtos disponíveis.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

            @foreach (var item in Model)
            {
                var produto = item.Produto;

                <div class="col">
                    <div class="card h-100 shadow-sm">

                        @if (!string.IsNullOrWhiteSpace(produto.imagem_url))
                        {
                            <img src="@produto.imagem_url"
                                 class="card-img-top"
                                 alt="@produto.nome"
                                 style="height: 260px; object-fit: cover;" />
                        }

                        <div class="card-body d-flex flex-column">

                            <h3 class="card-title h4">@produto.nome</h3>

                            <p class="text-muted mb-3">
                                Sabor: @produto.sabor
                            </p>

                            <p class="card-text">
                                @(string.IsNullOrWhiteSpace(produto.descricao)
                                    ? "Um doce preparado especialmente para você."
                                    : produto.descricao)
                            </p>

                            <div class="mt-auto pt-3">

                                <p class="fs-4 fw-bold mb-3">
                                    @produto.preco.ToString(
                                        "C",
                                        System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))
                                </p>

                                <small class="text-muted">
                                    Estoque disponível: @produto.estoque
                                </small>

                                <a asp-controller="Home"
                                   asp-action="Detalhes"
                                   asp-route-id="@produto.id_produto"
                                   class="btn btn-primary w-100 mt-3">
                                    Ver detalhes
                                </a>

                                <form asp-controller="Favorito"
                                      asp-action="@(item.EhFavorito ? "Remover" : "Adicionar")"
                                      method="post"
                                      class="mt-2">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="idProduto"
                                           value="@produto.id_produto" />

                                    <button type="submit"
                                            class="btn @(item.EhFavorito ? "btn-danger" : "btn-outline-danger") w-100"
                                            disabled="@(!clienteLogado)">

                                        <i class="bi bi-heart@(item.EhFavorito ? "-fill" : "")"></i>

                                        @if (!clienteLogado)
                                        {
                                            <text>Entre para favoritar</text>
                                        }
                                        else if (item.EhFavorito)
                                        {
                                            <text>Remover dos favoritos</text>
                                        }
                                        else
                                        {
                                            <text>Adicionar aos favoritos</text>
                                        }

                                    </button>
                                </form>

                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    }
</div>
