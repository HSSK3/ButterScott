
@model IEnumerable<ButterScott.Models.Categoria>

@{
    ViewData["Title"] = "Gerenciar categorias";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Gerenciar categorias</h2>
            <p class="text-muted mb-0">
                Visualize e gerencie as categorias dos produtos.
            </p>
        </div>

        <a asp-controller="Categoria"
           asp-action="Criar"
           class="btn btn-primary">
            Nova categoria
        </a>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">
            @TempData["Sucesso"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Nenhuma categoria cadastrada.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Descrição</th>
                        <th>Status</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var categoria in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @categoria.nome
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(categoria.descricao)
                                    ? "Sem descrição"
                                    : categoria.descricao)
                            </td>

                            <td>
                                @if (categoria.ativa)
                                {
                                    <span class="badge bg-success">
                                        Ativa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inativa
                                    </span>
                                }
                            </td>

                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-controller="Categoria"
                                       asp-action="Editar"
                                       asp-route-id="@categoria.id_categoria"
                                       class="btn btn-sm btn-outline-primary">
                                        Editar
                                    </a>

                                    <form asp-controller="Categoria"
                                          asp-action="AlterarStatus"
                                          asp-route-id="@categoria.id_categoria"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm @(categoria.ativa ? "btn-outline-danger" : "btn-outline-success")">
                                            @(categoria.ativa ? "Desativar" : "Ativar")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
