
@model ButterScott.Models.Categoria

@{
    ViewData["Title"] = "Editar categoria";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2>Editar categoria</h2>
        <p class="text-muted">
            Altere as informações da categoria selecionada.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-controller="Categoria"
                  asp-action="Editar"
                  asp-route-id="@Model.id_categoria"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="id_categoria" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="nome" class="form-label">
                        Nome da categoria
                    </label>

                    <input asp-for="nome"
                           class="form-control"
                           maxlength="80" />

                    <span asp-validation-for="nome"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="descricao" class="form-label">
                        Descrição
                    </label>

                    <textarea asp-for="descricao"
                              class="form-control"
                              rows="4"
                              maxlength="255">
                    </textarea>

                    <span asp-validation-for="descricao"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Salvar alterações
                    </button>

                    <a asp-controller="Categoria"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
