
@{
    ViewData["Title"] = "Criar conta";
}

<div class="container py-5" style="max-width: 480px;">
    <div class="text-center mb-4">
        <h1 class="fw-bold" style="color: #d85f50;">Crie sua conta</h1>
        <p class="text-muted">Faça seu cadastro para pedir seus cupcakes favoritos!</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <form asp-controller="Conta" asp-action="Cadastro" method="post">
                <div class="mb-3">
                    <label for="nome" class="form-label">Nome completo</label>
                    <input type="text"
                           id="nome"
                           name="nome"
                           class="form-control"
                           placeholder="Seu nome"
                           maxlength="150"
                           required />
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">E-mail</label>
                    <input type="email"
                           id="email"
                           name="email"
                           class="form-control"
                           placeholder="seuemail@exemplo.com"
                           maxlength="255"
                           required />
                </div>

                <div class="mb-3">
                    <label for="telefone" class="form-label">Telefone (opcional)</label>
                    <input type="tel"
                           id="telefone"
                           name="telefone"
                           class="form-control"
                           placeholder="Seu telefone"
                           maxlength="20" />
                </div>

                <div class="mb-4">
                    <label for="senha" class="form-label">Senha</label>
                    <input type="password"
                           id="senha"
                           name="senha"
                           class="form-control"
                           placeholder="Crie uma senha"
                           minlength="8"
                           required />
                    <small class="text-muted">Use pelo menos 8 caracteres.</small>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    Criar conta
                </button>
            </form>

            <hr class="my-4" />

            <p class="text-center mb-0">
                Já tem uma conta?
                <a asp-controller="Conta" asp-action="Login">Entrar</a>
            </p>
        </div>
    </div>
</div>
